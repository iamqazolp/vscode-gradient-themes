{
  "name": "gemini-prism-gradient-theme",
  "displayName": "Gemini Prism & Antarctic Frost Gradient Themes",
  "description": "Whisper-soft 7%\u201322% Antarctic & Glacial Single-Color Gradient Themes + Universal Translucent Gemini 4-Color Rainbow Overlay & Live Status Bar Randomizer for eye-friendly code reviewing.",
  "version": "1.1.0",
  "publisher": "iamqazolp",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#f4f8ff",
    "theme": "light"
  },
  "homepage": "https://github.com/iamqazolp/gemini-prism-gradient-theme#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/iamqazolp/gemini-prism-gradient-theme.git"
  },
  "bugs": {
    "url": "https://github.com/iamqazolp/gemini-prism-gradient-theme/issues"
  },
  "qna": "marketplace",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "gemini",
    "gradient",
    "rainbow",
    "randomizer",
    "antarctica",
    "glacial",
    "pastel",
    "minimal",
    "dark",
    "light",
    "theme",
    "antigravity"
  ],
  "scripts": {
    "package": "npx --yes @vscode/vsce package --baseImagesUrl https://raw.githubusercontent.com/iamqazolp/gemini-prism-gradient-theme/main --baseContentUrl https://github.com/iamqazolp/gemini-prism-gradient-theme/blob/main",
    "publish": "npx --yes @vscode/vsce publish --baseImagesUrl https://raw.githubusercontent.com/iamqazolp/gemini-prism-gradient-theme/main --baseContentUrl https://github.com/iamqazolp/gemini-prism-gradient-theme/blob/main",
    "publish:ovsx": "npx --yes ovsx publish"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "themes": [
      {
        "label": "Pure Blue Gradient (Sky to Sapphire Light)",
        "uiTheme": "vs",
        "path": "./themes/pure-blue-light-color-theme.json"
      },
      {
        "label": "Pure Blue Gradient (Abyssal Cobalt Dark)",
        "uiTheme": "vs-dark",
        "path": "./themes/pure-blue-dark-color-theme.json"
      },
      {
        "label": "Pure Green Gradient (Mint to Emerald Light)",
        "uiTheme": "vs",
        "path": "./themes/pure-green-light-color-theme.json"
      },
      {
        "label": "Pure Green Gradient (Forest Emerald Dark)",
        "uiTheme": "vs-dark",
        "path": "./themes/pure-green-dark-color-theme.json"
      },
      {
        "label": "Pure Pink Gradient (Sakura to Rose Light)",
        "uiTheme": "vs",
        "path": "./themes/pure-pink-light-color-theme.json"
      },
      {
        "label": "Pure Pink Gradient (Velvet Berry Dark)",
        "uiTheme": "vs-dark",
        "path": "./themes/pure-pink-dark-color-theme.json"
      },
      {
        "label": "Pure Yellow Gradient (Sunlit Honey Light)",
        "uiTheme": "vs",
        "path": "./themes/pure-yellow-light-color-theme.json"
      },
      {
        "label": "Pure Yellow Gradient (Golden Amber Dark)",
        "uiTheme": "vs-dark",
        "path": "./themes/pure-yellow-dark-color-theme.json"
      },
      {
        "label": "Pure Purple Gradient (Lavender to Amethyst Light)",
        "uiTheme": "vs",
        "path": "./themes/pure-purple-light-color-theme.json"
      },
      {
        "label": "Pure Purple Gradient (Cosmic Amethyst Dark)",
        "uiTheme": "vs-dark",
        "path": "./themes/pure-purple-dark-color-theme.json"
      },
      {
        "label": "Gemini Prism Light (Pastel 4-Color Star)",
        "uiTheme": "vs",
        "path": "./themes/gemini-prism-light-color-theme.json"
      },
      {
        "label": "Gemini Prism Dark (4-Color Star)",
        "uiTheme": "vs-dark",
        "path": "./themes/gemini-prism-dark-color-theme.json"
      }
    ],
    "commands": [
      {
        "command": "geminiPrism.enableGradientOverlay",
        "title": "Gemini Prism: Enable 4-Color Rainbow Gradient & Live Randomizer"
      },
      {
        "command": "geminiPrism.disableGradientOverlay",
        "title": "Gemini Prism: Disable 4-Color Rainbow Gradient Overlay"
      },
      {
        "command": "geminiPrism.rollRandomTheme",
        "title": "Gemini Prism: Roll Random Single-Color Glacial Theme"
      },
      {
        "command": "geminiPrism.openPreview",
        "title": "Gemini Prism: Open Interactive Theme & Gradient Preview"
      }
    ]
  }
}