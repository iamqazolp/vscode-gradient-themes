  "tokenColors": [
    {
      "name": "Comments & Docblocks",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#877352",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Docstrings",
      "scope": [
        "string.quoted.docstring",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#705324",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Storage",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.logical",
        "keyword.operator.wordlike",
        "keyword.operator.new",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#6E470B"
      }
    },
    {
      "name": "Function Parameters & Decorators",
      "scope": [
        "variable.parameter",
        "meta.function.parameters variable",
        "entity.name.variable.parameter",
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.definition.decorator"
      ],
      "settings": {
        "foreground": "#664C22"
      }
    },
    {
      "name": "Classes, Types & Structs",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#754A0E"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#5E4B24"
      }
    },
    {
      "name": "Operators, Punctuation & Regex",
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor",
        "constant.character.escape",
        "punctuation.definition.template-expression",
        "constant.other.placeholder",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#59482B"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "variable.function"
      ],
      "settings": {
        "foreground": "#7A5211"
      }
    },
    {
      "name": "Object Properties & Attributes",
      "scope": [
        "variable.other.property",
        "support.variable.property",
        "meta.attribute",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#544326"
      }
    },
    {
      "name": "Numbers, Constants & Booleans",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#7D4E14"
      }
    },
    {
      "name": "Self / This / Language Variables",
      "scope": [
        "variable.language",
        "variable.language.self",
        "variable.language.this"
      ],
      "settings": {
        "foreground": "#6E470B",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variables & Identifiers",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#241C0E"
      }
    },
    {
      "name": "HTML / JSX / XML Tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#6E470B"
      }
    },
    {
      "name": "JSON / YAML Keys",
      "scope": [
        "support.type.property-name.json",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#7A5211"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#6E470B",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#241C0E",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#59482B",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown Inline Code & Raw Blocks",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#5E4B24"
      }
    },
    {
      "name": "Markdown Links",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "support.class.math",
        "constant.character.math"
      ],
      "settings": {
        "foreground": "#7A5211"
      }
    }
  ],
  "semanticTokenColors": {
    "function": "#7A5211",
    "method": "#7A5211",
    "class": "#754A0E",
    "type": "#754A0E",
    "interface": "#754A0E",
    "namespace": "#544326",
    "parameter": "#664C22",
    "variable.readonly": "#7D4E14",
    "property": "#544326",
    "keyword": "#6E470B",
    "number": "#7D4E14",
    "string": "#5E4B24",
    "decorator": "#664C22"
  }
}