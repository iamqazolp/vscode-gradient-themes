  "tokenColors": [
    {
      "name": "Comments & Docblocks",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6465A0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Docstrings",
      "scope": [
        "string.quoted.docstring",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#2D3780",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Storage",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.logical",
        "keyword.operator.wordlike",
        "keyword.operator.new",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#271B83"
      }
    },
    {
      "name": "Function Parameters & Decorators",
      "scope": [
        "variable.parameter",
        "meta.function.parameters variable",
        "entity.name.variable.parameter",
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.definition.decorator"
      ],
      "settings": {
        "foreground": "#45347F"
      }
    },
    {
      "name": "Classes, Types & Structs",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#203179"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#1E3E78"
      }
    },
    {
      "name": "Operators, Punctuation & Regex",
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor",
        "constant.character.escape",
        "punctuation.definition.template-expression",
        "constant.other.placeholder",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#393A6F"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "variable.function"
      ],
      "settings": {
        "foreground": "#191C8F"
      }
    },
    {
      "name": "Object Properties & Attributes",
      "scope": [
        "variable.other.property",
        "support.variable.property",
        "meta.attribute",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#2F2C6D"
      }
    },
    {
      "name": "Numbers, Constants & Booleans",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#432782"
      }
    },
    {
      "name": "Self / This / Language Variables",
      "scope": [
        "variable.language",
        "variable.language.self",
        "variable.language.this"
      ],
      "settings": {
        "foreground": "#271B83",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variables & Identifiers",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#11112F"
      }
    },
    {
      "name": "HTML / JSX / XML Tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#271B83"
      }
    },
    {
      "name": "JSON / YAML Keys",
      "scope": [
        "support.type.property-name.json",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#191C8F"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#271B83",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#11112F",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#393A6F",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown Inline Code & Raw Blocks",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#1E3E78"
      }
    },
    {
      "name": "Markdown Links",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "support.class.math",
        "constant.character.math"
      ],
      "settings": {
        "foreground": "#191C8F"
      }
    }
  ],
  "semanticTokenColors": {
    "function": "#191C8F",
    "method": "#191C8F",
    "class": "#203179",
    "type": "#203179",
    "interface": "#203179",
    "namespace": "#2F2C6D",
    "parameter": "#45347F",
    "variable.readonly": "#432782",
    "property": "#2F2C6D",
    "keyword": "#271B83",
    "number": "#432782",
    "string": "#1E3E78",
    "decorator": "#45347F"
  }
}
