  "tokenColors": [
    {
      "name": "Comments & Docblocks",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#588268",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Docstrings",
      "scope": [
        "string.quoted.docstring",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#78BFA0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Storage",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.logical",
        "keyword.operator.wordlike",
        "keyword.operator.new",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#7AD99E"
      }
    },
    {
      "name": "Function Parameters & Decorators",
      "scope": [
        "variable.parameter",
        "meta.function.parameters variable",
        "entity.name.variable.parameter",
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.definition.decorator"
      ],
      "settings": {
        "foreground": "#98C9AA"
      }
    },
    {
      "name": "Classes, Types & Structs",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#A6E3BD"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#74C796"
      }
    },
    {
      "name": "Operators, Punctuation & Regex",
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor",
        "constant.character.escape",
        "punctuation.definition.template-expression",
        "constant.other.placeholder",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#96C4A8"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "variable.function"
      ],
      "settings": {
        "foreground": "#94E0B2"
      }
    },
    {
      "name": "Object Properties & Attributes",
      "scope": [
        "variable.other.property",
        "support.variable.property",
        "meta.attribute",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#B0D9C0"
      }
    },
    {
      "name": "Numbers, Constants & Booleans",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#85CCB1"
      }
    },
    {
      "name": "Self / This / Language Variables",
      "scope": [
        "variable.language",
        "variable.language.self",
        "variable.language.this"
      ],
      "settings": {
        "foreground": "#7AD99E",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variables & Identifiers",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#E2F2E8"
      }
    },
    {
      "name": "HTML / JSX / XML Tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#7AD99E"
      }
    },
    {
      "name": "JSON / YAML Keys",
      "scope": [
        "support.type.property-name.json",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#94E0B2"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#7AD99E",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#E2F2E8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#96C4A8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown Inline Code & Raw Blocks",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#74C796"
      }
    },
    {
      "name": "Markdown Links",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "support.class.math",
        "constant.character.math"
      ],
      "settings": {
        "foreground": "#94E0B2"
      }
    }
  ],
  "semanticTokenColors": {
    "function": "#94E0B2",
    "method": "#94E0B2",
    "class": "#A6E3BD",
    "type": "#A6E3BD",
    "interface": "#A6E3BD",
    "namespace": "#B0D9C0",
    "parameter": "#98C9AA",
    "variable.readonly": "#85CCB1",
    "property": "#B0D9C0",
    "keyword": "#7AD99E",
    "number": "#85CCB1",
    "string": "#74C796",
    "decorator": "#98C9AA"
  }
}