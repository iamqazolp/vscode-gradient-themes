  "tokenColors": [
    {
      "name": "Comments & Docblocks",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#877758",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Docstrings",
      "scope": [
        "string.quoted.docstring",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#CFB57E",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Storage",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.logical",
        "keyword.operator.wordlike",
        "keyword.operator.new",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#E0BE6E"
      }
    },
    {
      "name": "Function Parameters & Decorators",
      "scope": [
        "variable.parameter",
        "meta.function.parameters variable",
        "entity.name.variable.parameter",
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.definition.decorator"
      ],
      "settings": {
        "foreground": "#C9AE74"
      }
    },
    {
      "name": "Classes, Types & Structs",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#EDD28E"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#D4B475"
      }
    },
    {
      "name": "Operators, Punctuation & Regex",
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor",
        "constant.character.escape",
        "punctuation.definition.template-expression",
        "constant.other.placeholder",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#C9B792"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "variable.function"
      ],
      "settings": {
        "foreground": "#E8C87D"
      }
    },
    {
      "name": "Object Properties & Attributes",
      "scope": [
        "variable.other.property",
        "support.variable.property",
        "meta.attribute",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#DBC8A0"
      }
    },
    {
      "name": "Numbers, Constants & Booleans",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#D9B262"
      }
    },
    {
      "name": "Self / This / Language Variables",
      "scope": [
        "variable.language",
        "variable.language.self",
        "variable.language.this"
      ],
      "settings": {
        "foreground": "#E0BE6E",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variables & Identifiers",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#F7F0E2"
      }
    },
    {
      "name": "HTML / JSX / XML Tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#E0BE6E"
      }
    },
    {
      "name": "JSON / YAML Keys",
      "scope": [
        "support.type.property-name.json",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#E8C87D"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#E0BE6E",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#F7F0E2",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#C9B792",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown Inline Code & Raw Blocks",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#D4B475"
      }
    },
    {
      "name": "Markdown Links",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "support.class.math",
        "constant.character.math"
      ],
      "settings": {
        "foreground": "#E8C87D"
      }
    }
  ],
  "semanticTokenColors": {
    "function": "#E8C87D",
    "method": "#E8C87D",
    "class": "#EDD28E",
    "type": "#EDD28E",
    "interface": "#EDD28E",
    "namespace": "#DBC8A0",
    "parameter": "#C9AE74",
    "variable.readonly": "#D9B262",
    "property": "#DBC8A0",
    "keyword": "#E0BE6E",
    "number": "#D9B262",
    "string": "#D4B475",
    "decorator": "#C9AE74"
  }
}