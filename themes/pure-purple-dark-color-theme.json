  "tokenColors": [
    {
      "name": "Comments & Docblocks",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#756599",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Docstrings",
      "scope": [
        "string.quoted.docstring",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#B29CE0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Storage",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.logical",
        "keyword.operator.wordlike",
        "keyword.operator.new",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#B99EF0"
      }
    },
    {
      "name": "Function Parameters & Decorators",
      "scope": [
        "variable.parameter",
        "meta.function.parameters variable",
        "entity.name.variable.parameter",
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.definition.decorator"
      ],
      "settings": {
        "foreground": "#B5A0DC"
      }
    },
    {
      "name": "Classes, Types & Structs",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#CBB6F8"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#A599E8"
      }
    },
    {
      "name": "Operators, Punctuation & Regex",
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor",
        "constant.character.escape",
        "punctuation.definition.template-expression",
        "constant.other.placeholder",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#B6A6D9"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "variable.function"
      ],
      "settings": {
        "foreground": "#C3ADEF"
      }
    },
    {
      "name": "Object Properties & Attributes",
      "scope": [
        "variable.other.property",
        "support.variable.property",
        "meta.attribute",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#C6B8E8"
      }
    },
    {
      "name": "Numbers, Constants & Booleans",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#B898ED"
      }
    },
    {
      "name": "Self / This / Language Variables",
      "scope": [
        "variable.language",
        "variable.language.self",
        "variable.language.this"
      ],
      "settings": {
        "foreground": "#B99EF0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variables & Identifiers",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#EFEBF9"
      }
    },
    {
      "name": "HTML / JSX / XML Tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#B99EF0"
      }
    },
    {
      "name": "JSON / YAML Keys",
      "scope": [
        "support.type.property-name.json",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#C3ADEF"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#B99EF0",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#EFEBF9",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#B6A6D9",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown Inline Code & Raw Blocks",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#A599E8"
      }
    },
    {
      "name": "Markdown Links",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "support.class.math",
        "constant.character.math"
      ],
      "settings": {
        "foreground": "#C3ADEF"
      }
    }
  ],
  "semanticTokenColors": {
    "function": "#C3ADEF",
    "method": "#C3ADEF",
    "class": "#CBB6F8",
    "type": "#CBB6F8",
    "interface": "#CBB6F8",
    "namespace": "#C6B8E8",
    "parameter": "#B5A0DC",
    "variable.readonly": "#B898ED",
    "property": "#C6B8E8",
    "keyword": "#B99EF0",
    "number": "#B898ED",
    "string": "#A599E8",
    "decorator": "#B5A0DC"
  }
}